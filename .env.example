# Serveur
PORT=8080
HM_INGEST_TOKEN=<secret partagé avec les services>
HM_LOG_LEVEL=INFO

# Services surveillés
HM_SERVICES=moddy-bot,moddy-api,moddy-altguard,moddy-feeds
HM_CRITICAL_SERVICES=moddy-bot,moddy-api
# Noms d'affichage (optionnel, des défauts existent pour les services Moddy)
HM_SERVICE_NAMES=moddy-bot:Moddy Bot,moddy-api:API,moddy-altguard:AltGuard,moddy-feeds:Feeds
# Propagation d'impact : `source>cible1,cible2`, entrées séparées par `;`,
# `*` = tous les autres services connus. Seul un service `down` propage ; la
# propagation produit du `degraded`, ou du `down` sur une cible suffixée `=down`
# (sans backend, le dashboard n'affiche plus rien). Voir docs/detection.md.
HM_IMPACT_MAP=moddy-bot>*;moddy-api>moddy-website,moddy-dashboard=down,moddy-bot
HM_HEARTBEAT_TTL=60
HM_CHECK_INTERVAL=15
HM_FAILURE_THRESHOLD=3
HM_RECOVERY_THRESHOLD=2
HM_STARTUP_GRACE=90
HM_MIN_SILENCE=60
HM_NOTIFY_RATE_LIMIT=300

# Checks HTTP actifs — pour les services sans process capable de pousser un
# heartbeat (dashboard, site statique). `service:url`, séparés par `,`.
# Un 2xx signifie vivant, tout le reste vaut `down`. Vide = boucle non démarrée.
HM_PROBE_MAP=moddy-dashboard:https://dashboard.moddy.app/healthz
HM_PROBE_INTERVAL=30
HM_PROBE_TIMEOUT=10

# Redis
REDIS_URL=redis://default:xxx@redis.railway.internal:6379

# Better Stack
BETTERSTACK_TOKEN=
BETTERSTACK_API_BASE=https://uptime.betterstack.com/api/v2
BETTERSTACK_STATUS_PAGE_ID=237745
BETTERSTACK_INDEX_URL=https://status.moddy.app/index.json
BETTERSTACK_POLL_INTERVAL=300          # secours uniquement, le webhook est le chemin principal
BETTERSTACK_WEBHOOK_SECRET=            # placé en query string sur /ingest/betterstack
HM_BS_RESOURCE_MAP=moddy-bot:8720238,moddy-website:8720239,moddy-dashboard:8720240,moddy-api:8720241
HM_SELF_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/<token>
HM_SELF_HEARTBEAT_INTERVAL=60
HM_BS_ADOPT_MAX_AGE=3600               # au-delà, un incident BS inconnu est de l'archive
HM_BS_WEBHOOK_SILENCE_ALERT=86400

# Discord — bot
# Token de l'application dédiée « Moddy Health Monitor », jamais celui de Moddy :
# le monitor doit rester capable de parler quand Moddy est down. Vide = bot
# désactivé, tout passe par le webhook.
DISCORD_TOKEN=
DISCORD_GUILD_ID=1394001780148535387
DISCORD_STATUS_CHANNEL_ID=1398625686301704323
DISCORD_STAFF_ROLE_ID=                 # vide = repli sur la permission manage_guild
DISCORD_STATUS_PAGE_URL=https://status.moddy.app

# Discord — repli. À créer À LA MAIN dans les paramètres du salon, jamais par
# l'application Health Monitor : si son token est compromis ou l'app suspendue,
# le webhook doit lui survivre.
DISCORD_WEBHOOK_URL=

# Discord — comportement
HM_BOT_ACK_TIMEOUT=5                   # bascule webhook au-delà
HM_STICKY_ENABLED=true
HM_STICKY_DEBOUNCE=5                   # secondes avant repost après un message tiers
HM_STICKY_REFRESH_INTERVAL=120         # rafraîchissement passif du contenu
HM_REFRESH_COOLDOWN=5                  # anti-spam du bouton Refresh, par utilisateur

# Public API
HM_PUBLIC_RATE_LIMIT=60/minute
HM_CORS_ORIGINS=https://moddy.app,https://dashboard.moddy.app
HM_PUBLIC_CACHE_TTL=30
